<% deleted = message.content_attributes["deleted"] %>
<div class="outline outline-1 outline-n-container rounded-lg p-4 shadow-sm">
  <div class="flex items-center justify-between mb-2">
    <div class="flex items-center gap-2 text-sm">
      <span class="font-medium text-n-slate-12"><%= message.sender&.name.presence || "(system)" %></span>
      <span class="px-2 h-4 leading-4 rounded-xl bg-slate-100 text-slate-800 text-xxs uppercase"><%= message.message_type %></span>
      <% if message.private? %>
        <span class="px-2 h-4 leading-4 rounded-xl bg-amber-100 text-amber-800 text-xxs">private</span>
      <% end %>
      <span class="text-n-slate-11"><%= message.created_at.to_fs(:short) %></span>
    </div>
    <% unless deleted %>
      <%= button_to "Delete", super_admin_account_conversation_message_path(@account, @conversation, message),
            method: :delete, class: "button", data: { confirm: "Soft-delete this message?" } %>
    <% end %>
  </div>

  <% if deleted %>
    <p class="text-n-slate-11 italic m-0"><%= message.content %></p>
  <% else %>
    <%= form_with url: super_admin_account_conversation_message_path(@account, @conversation, message), method: :patch, scope: :message do |f| %>
      <%= f.text_area :content, value: message.content.to_s, rows: 3, class: "w-full text-sm" %>
      <div class="mt-2">
        <%= f.submit "Save message", class: "button" %>
      </div>
    <% end %>

    <% if message.attachments.present? %>
      <div class="mt-2 text-sm text-n-slate-11">
        <span class="font-medium">Attachments:</span>
        <%= safe_join(message.attachments.map { |a| link_to(a.file_type, a.download_url, target: "_blank", rel: "noopener", class: "text-woot-800") }, ", ") %>
      </div>
    <% end %>
  <% end %>
</div>
