<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field" data-contact-hiding-form>
  <label class="flex items-center gap-2">
    <%= hidden_field_tag 'account[contact_hiding_policy][enabled]', '0', id: nil %>
    <%= check_box_tag 'account[contact_hiding_policy][enabled]', '1', field.enabled?,
                      data: { contact_hiding_toggle: true } %>
    <span><%= t('super_admin.contact_hiding.form.enabled') %></span>
  </label>

  <div class="mt-3 flex flex-wrap items-end gap-4" data-contact-hiding-inputs>
    <label class="flex flex-col gap-1 text-sm">
      <%= t('super_admin.contact_hiding.form.visible_per_cycle') %>
      <%= number_field_tag 'account[contact_hiding_policy][visible_per_cycle]',
                           field.visible_per_cycle, min: 0, step: 1 %>
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <%= t('super_admin.contact_hiding.form.hidden_per_cycle') %>
      <%= number_field_tag 'account[contact_hiding_policy][hidden_per_cycle]',
                           field.hidden_per_cycle, min: 0, step: 1 %>
    </label>
  </div>

  <p class="mt-2 text-xs text-n-slate-11"><%= t('super_admin.contact_hiding.form.help') %></p>
</div>
