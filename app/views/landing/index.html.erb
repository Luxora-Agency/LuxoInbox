<%
  manifesto = 'WHATSAPP, INSTAGRAM, CORREO Y MÁS. CADA MENSAJE DE TUS CLIENTES, RESPONDIDO DESDE UN SOLO LUGAR.'
  cta_lines = ['Centraliza tus canales.', 'Responde más rápido.', 'Vende más.']
%>
<main>
  <!-- ================================================================ Hero -->
  <section id="home" class="hero">
    <video class="section-video" src="<%= LandingController::HERO_VIDEO %>" autoplay loop muted playsinline></video>

    <div class="hero__inner">
      <%= render 'nav', variant: :home %>

      <div class="container hero__copy">
        <div class="hero__headline-wrap">
          <h1 class="hero__headline fade-up fade-up-2">Todas tus conversaciones en una sola bandeja</h1>
          <span class="accent hero__accent fade-up fade-up-3">Atención al cliente</span>
        </div>

        <%= render 'social_links', variant: :inline %>
      </div>
    </div>

    <%= render 'social_links', variant: :rail %>
  </section>

  <!-- =============================================================== About -->
  <section id="about" class="about">
    <video class="section-video" src="<%= LandingController::ABOUT_VIDEO %>" autoplay loop muted playsinline></video>

    <div class="container about__inner">
      <div class="about__top">
        <div class="about__heading-wrap">
          <h2 class="about__heading">¡Hola! Somos LuxoInbox</h2>
          <span class="accent about__accent">LuxoInbox</span>
        </div>

        <p class="manifesto"><%= manifesto %></p>
      </div>

      <!-- Decorative repetition of the manifesto; the second column only shows from lg up. -->
      <div class="about__bottom">
        <div class="about__column">
          <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
          <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
        </div>

        <div class="about__column about__column--secondary">
          <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
          <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== Collection -->
  <section id="collection" class="collection">
    <div class="container">
      <div class="collection__head">
        <h2 class="collection__heading">
          Elige tu
          <span class="collection__heading-line"><span class="collection__heading-accent">Plan</span> Ideal</span>
        </h2>

        <a href="#collection-grid" class="collection__all" aria-label="Ver todos los planes disponibles">
          <span class="collection__all-label">
            <span class="collection__all-lead">Ver</span>
            <span class="collection__all-stack">
              <span>Todos</span>
              <span>Planes</span>
            </span>
          </span>
          <span class="collection__all-rule" aria-hidden="true"></span>
        </a>
      </div>

      <div id="collection-grid" class="collection__grid">
        <%= render partial: 'plan_card', collection: @plans, as: :plan %>
      </div>
    </div>
  </section>

  <!-- ================================================================= CTA -->
  <section id="buy" class="cta">
    <video class="cta__video" src="<%= LandingController::CTA_VIDEO %>" autoplay loop muted playsinline></video>

    <div class="cta__overlay">
      <div class="cta__inner">
        <div class="cta__copy">
          <span class="accent cta__accent">Da el salto</span>

          <a class="cta__link" href="/app/auth/signup">Empieza hoy.</a>

          <% cta_lines.each do |line| %>
            <p class="cta__line"><%= line %></p>
          <% end %>
        </div>
      </div>

      <%= render 'social_links', variant: :stack %>
    </div>
  </section>
</main>

<%= render 'footer' %>
