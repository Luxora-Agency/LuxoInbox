<%
  # Inlined glyphs: the lucide marks the standalone site used (mail, chevron-right, x)
  # plus the two brand marks lucide dropped upstream. Sized from landing.css.
  icons = {
    mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" ' \
          'stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/>' \
          '<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
    x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 ' \
       '11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 ' \
       '4.126H5.117L17.083 19.77Z"/></svg>',
    github: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5Z"/></svg>',
    chevron_right: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" ' \
                   'stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>'
  }.transform_values(&:html_safe)

  nav_links = [
    { label: 'INICIO', href: '#home' },
    { label: 'PRODUCTO', href: '#about' },
    { label: 'PLANES', href: '#collection' },
    { label: 'COMPRAR', href: '#collection-grid' }
  ]

  social_links = [
    { label: 'Escríbenos por correo', href: 'mailto:hola@luxoinbox.com', icon: :mail },
    { label: 'LuxoInbox en X', href: 'https://x.com', icon: :x },
    { label: 'LuxoInbox en GitHub', href: 'https://github.com', icon: :github }
  ]

  manifesto = 'WHATSAPP, INSTAGRAM, CORREO Y MÁS. CADA MENSAJE DE TUS CLIENTES, RESPONDIDO DESDE UN SOLO LUGAR.'
  cta_lines = ['Centraliza tus canales.', 'Responde más rápido.', 'Vende más.']

  format_cop = ->(cents) { "$ #{(cents / 100).to_s.reverse.scan(/\d{1,3}/).join('.').reverse} COP" }
%><!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/landing/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LuxoInbox - WhatsApp, Instagram y correo en una sola bandeja para atender a tus clientes." />
    <title>LuxoInbox — Todas tus conversaciones en una sola bandeja</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Condiment&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/landing/landing.css" />
    <script src="https://checkout.wompi.co/widget.js"></script>
    <script src="/landing/landing.js" defer></script>
  </head>
  <body data-wompi-public-key="<%= @wompi_public_key %>">
    <main>
      <!-- ================================================================ Hero -->
      <section id="home" class="hero">
        <video class="section-video" src="<%= LandingController::HERO_VIDEO %>" autoplay loop muted playsinline></video>

        <div class="hero__inner">
          <header class="container hero__header fade-up fade-up-1">
            <a href="#home" class="hero__logo">LuxoInbox</a>

            <nav class="nav liquid-glass">
              <ul class="nav__list">
                <% nav_links.each do |link| %>
                  <li><a class="nav__link" href="<%= link[:href] %>"><%= link[:label] %></a></li>
                <% end %>
                <li><a class="nav__link" id="session-link" href="/app/login">INGRESAR</a></li>
              </ul>
            </nav>
          </header>

          <div class="container hero__copy">
            <div class="hero__headline-wrap">
              <h1 class="hero__headline fade-up fade-up-2">Todas tus conversaciones en una sola bandeja</h1>
              <span class="accent hero__accent fade-up fade-up-3">Atención al cliente</span>
            </div>

            <div class="social-buttons social-buttons--inline fade-up fade-up-4">
              <% social_links.each do |link| %>
                <a class="social-button liquid-glass" href="<%= link[:href] %>" target="_blank" rel="noreferrer" aria-label="<%= link[:label] %>"><%= icons[link[:icon]] %></a>
              <% end %>
            </div>
          </div>
        </div>

        <div class="social-buttons social-buttons--rail fade-up fade-up-4">
          <% social_links.each do |link| %>
            <a class="social-button liquid-glass" href="<%= link[:href] %>" target="_blank" rel="noreferrer" aria-label="<%= link[:label] %>"><%= icons[link[:icon]] %></a>
          <% end %>
        </div>
      </section>

      <!-- =============================================================== About -->
      <section id="about" class="about">
        <video class="section-video" src="<%= LandingController::ABOUT_VIDEO %>" autoplay loop muted playsinline></video>

        <div class="container about__inner">
          <div class="about__top">
            <div class="about__heading-wrap">
              <h2 class="about__heading">¡Hola! Somos LuxoInbox</h2>
              <span class="accent about__accent">LuxoInbox</span>
            </div>

            <p class="manifesto"><%= manifesto %></p>
          </div>

          <!-- Decorative repetition of the manifesto; the second column only shows from lg up. -->
          <div class="about__bottom">
            <div class="about__column">
              <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
              <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
            </div>

            <div class="about__column about__column--secondary">
              <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
              <p class="manifesto" aria-hidden="true"><%= manifesto %></p>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================================== Collection -->
      <section id="collection" class="collection">
        <div class="container">
          <div class="collection__head">
            <h2 class="collection__heading">
              Elige tu
              <span class="collection__heading-line"><span class="collection__heading-accent">Plan</span> Ideal</span>
            </h2>

            <a href="#collection-grid" class="collection__all" aria-label="Ver todos los planes disponibles">
              <span class="collection__all-label">
                <span class="collection__all-lead">Ver</span>
                <span class="collection__all-stack">
                  <span>Todos</span>
                  <span>Planes</span>
                </span>
              </span>
              <span class="collection__all-rule" aria-hidden="true"></span>
            </a>
          </div>

          <div id="collection-grid" class="collection__grid">
            <% @plans.each do |plan| %>
              <% price = "#{format_cop.call(plan[:price_in_cents])} / MES" %>
              <article class="plan-card liquid-glass">
                <div class="plan-card__media">
                  <video class="plan-card__video" src="<%= plan[:video] %>" autoplay loop muted playsinline></video>

                  <div class="plan-card__bar liquid-glass">
                    <div class="plan-card__text">
                      <p class="plan-card__name"><%= plan[:name] %></p>
                      <p class="plan-card__meta">
                        Agentes incluidos: <span class="plan-card__agents"><%= plan[:agents] %></span>
                      </p>
                      <p class="plan-card__meta"><%= price %></p>
                    </div>

                    <button type="button" class="plan-card__buy" data-plan-id="<%= plan[:id] %>" data-plan-name="<%= plan[:name] %>" data-plan-price="<%= format_cop.call(plan[:price_in_cents]) %>" aria-label="Contratar el plan <%= plan[:name] %> por <%= price %>"><%= icons[:chevron_right] %></button>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      </section>

      <!-- ================================================================= CTA -->
      <section id="buy" class="cta">
        <video class="cta__video" src="<%= LandingController::CTA_VIDEO %>" autoplay loop muted playsinline></video>

        <div class="cta__overlay">
          <div class="cta__inner">
            <div class="cta__copy">
              <span class="accent cta__accent">Da el salto</span>

              <a class="cta__link" href="/app/auth/signup">Empieza hoy.</a>

              <% cta_lines.each do |line| %>
                <p class="cta__line"><%= line %></p>
              <% end %>
            </div>
          </div>

          <div class="social-stack liquid-glass">
            <% social_links.each do |link| %>
              <a class="social-stack__link" href="<%= link[:href] %>" target="_blank" rel="noreferrer" aria-label="<%= link[:label] %>"><%= icons[link[:icon]] %></a>
            <% end %>
          </div>
        </div>
      </section>
    </main>

    <div id="toast-root"></div>
    <div class="texture-overlay" aria-hidden="true"></div>
  </body>
</html>
