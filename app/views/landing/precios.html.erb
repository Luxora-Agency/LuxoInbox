<% content_for :page_title, 'Planes y precios — LuxoInbox' %>
<% content_for :meta_description, 'Planes mensuales en pesos colombianos, con pago seguro vía Wompi: tarjetas, PSE y Nequi. Sin permanencia mínima.' %>
<%
  plan_pitches = {
    'starter' => 'Para equipos que arrancan.',
    'growth' => 'El favorito para crecer.',
    'advanced' => 'Control y escala.',
    'enterprise' => 'Usuarios ilimitados y límites a tu medida.'
  }

  plan_features = {
    'starter' => [
      '5 agentes incluidos',
      'Bandeja de equipo y notas internas',
      'Canales de chat web y correo',
      'App móvil',
      'Respuestas rápidas',
      'Reportes básicos',
      'Autenticación en dos pasos (2FA)'
    ],
    'growth' => [
      'Todo lo de Starter',
      'Todos los canales: WhatsApp, Instagram, Facebook, correo y chat web',
      'Difusiones y campañas',
      'Automatizaciones y macros',
      'Reportes avanzados y CSAT',
      'API para desarrolladores'
    ],
    'advanced' => [
      'Todo lo de Growth',
      'Múltiples cuentas y espacios de trabajo',
      'SSO / SAML',
      'Webhooks y solicitudes HTTP en automatizaciones',
      'Roles personalizados y auditoría',
      'SLA y atributos requeridos'
    ],
    'enterprise' => [
      'Usuarios ilimitados',
      'Límites a tu medida',
      'Soporte dedicado'
    ]
  }

  faqs = [
    { question: '¿Cómo puedo pagar?',
      answer: 'A través de Wompi, la pasarela de pagos colombiana: tarjetas de crédito y débito, PSE y Nequi. El cobro es mensual y se procesa en pesos colombianos.' },
    { question: '¿Puedo cambiar de plan?',
      answer: 'Sí. Puedes subir o bajar de plan cuando quieras y el cambio aplica desde tu siguiente ciclo de facturación.' },
    { question: '¿Puedo agregar más agentes?',
      answer: 'Sí, cada plan permite agentes adicionales; escríbenos y lo activamos por un cargo mensual por agente.' },
    { question: '¿Hay permanencia mínima?',
      answer: 'No. Los planes son mensuales y puedes cancelar en cualquier momento, sin penalidades ni cobros adicionales.' },
    { question: '¿Qué pasa cuando vence mi plan?',
      answer: 'Te avisamos antes del vencimiento. Si el pago no se renueva, tu cuenta queda en pausa hasta que reactives el plan; tus conversaciones y datos no se borran.' },
    { question: '¿Facturan en pesos colombianos?',
      answer: 'Sí. Todos los precios están en COP y el cobro se hace en Colombia, sin sorpresas por tasa de cambio.' },
    { question: '¿Qué soporte incluye mi plan?',
      answer: 'Todos los planes incluyen soporte por correo, y el plan Enterprise suma soporte dedicado con acompañamiento.' }
  ]
%>
<main>
  <%= render 'nav' %>

  <section class="page-hero">
    <div class="container">
      <p class="page-hero__kicker fade-up fade-up-1">Planes</p>
      <div class="page-hero__heading-wrap">
        <h1 class="page-hero__heading fade-up fade-up-2">Planes claros. Precios en COP.</h1>
        <span class="accent page-hero__accent fade-up fade-up-3">Sin sorpresas</span>
      </div>
    </div>
  </section>

  <section class="collection collection--page">
    <div class="container">
      <div class="collection__grid">
        <%= render partial: 'plan_card', collection: @plans, as: :plan %>
      </div>
    </div>
  </section>

  <section class="compare">
    <div class="container">
      <h2 class="compare__heading">Qué incluye cada plan</h2>

      <div class="compare__grid">
        <% @plans.each do |plan| %>
          <article class="compare-card liquid-glass">
            <h3 class="compare-card__name"><%= plan[:name] %></h3>
            <p class="compare-card__pitch"><%= plan_pitches[plan[:id]] %></p>
            <p class="compare-card__price">
              <%= plan[:price_in_cents].present? ? "#{format_cop(plan[:price_in_cents])} / MES" : 'A LA MEDIDA' %>
            </p>

            <ul class="compare-card__list">
              <% plan_features[plan[:id]].each do |feature| %>
                <li class="compare-card__item"><%= feature %></li>
              <% end %>
            </ul>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <div class="faq__inner">
        <h2 class="faq__heading">Preguntas frecuentes</h2>

        <% faqs.each do |faq| %>
          <details class="faq__item liquid-glass">
            <summary class="faq__question">
              <%= faq[:question] %>
              <span class="faq__marker" aria-hidden="true"><%= landing_icon(:chevron_right) %></span>
            </summary>
            <p class="faq__answer"><%= faq[:answer] %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <span class="accent cta-band__accent">Da el salto</span>
      <a class="cta-band__link" href="/app/auth/signup">Empieza hoy.</a>
      <p class="cta-band__line">Crea tu cuenta y conecta tus canales.</p>
    </div>
  </section>
</main>

<%= render 'footer' %>
